# Local MongoDB (Windows service). Use an Atlas URI in production.
MONGODB_URI=mongodb://localhost:27017/kawiquest

# Signs session cookies. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public base URL, used in password-reset and invite links.
APP_URL=http://localhost:3000

# Optional: send email through Resend. Without it, emails are printed to the server console.
RESEND_API_KEY=
MAIL_FROM=KawiQuest <no-reply@example.com>
